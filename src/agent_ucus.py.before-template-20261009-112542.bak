"""Kullanıcı komutlarıyla uçuş: otomatik manevra, hedef seçimi veya atış yok."""
import copy
import os
import sys
import time
from pathlib import Path
from types import ModuleType, SimpleNamespace

workspace = Path(__file__).resolve().parents[1]
bvrgym = workspace / "BVRGym"
sys.path.insert(0, str(bvrgym))

from data_classes.agent_dataclass import Agent_parameters
from jsb_gym.agents.agents import BaseBVRAgent
from jsb_gym.simObjects.config import f16_config, AAM_config
from jsb_gym.utils.loggers import TacviewLogger


# Senaryonun kullanıcı tarafından verilen başlangıç ayarları.
# lat/long: derece, alt: metre, vel: m/s, heading: derece.
# initial_command: [hedef yön (derece), hedef irtifa (metre), gaz (0–1)].
AGENT_CONFIGS = [
    dict(
        name="Kartal-1",
        team="Blue",
        missile_count=2,
        spawn=dict(lat=59.0, long=18.0, alt=8000, vel=300, heading=0),
        initial_command=[0, 5000, 0.99],
    ),
    dict(
        name="Bogey-1",
        team="Red",
        missile_count=2,
        spawn=dict(lat=59.25, long=18.0, alt=3000, vel=300, heading=180),
        initial_command=[180, 7000, 0.99],
    ),
]

SIM_DURATION = 180  # Kullanıcının verdiği azami simülasyon süresi, saniye.
RECORDING_DIR = workspace / "recordings" / "agent_ucus"


def copy_config(config):
    return SimpleNamespace(**{
        key: copy.deepcopy(value)
        for key, value in vars(config).items()
        if not key.startswith("_") and not isinstance(value, ModuleType)
    })


def create_agent(*, name, team, missile_count, spawn):
    """İsim, takım, mühimmat ve spawn bilgisiyle bir BaseBVRAgent oluştur."""
    if not isinstance(missile_count, int) or missile_count < 0:
        raise ValueError("missile_count sıfır veya pozitif bir tam sayı olmalı")
    if not name or any(char in name for char in '/\\:*?"<>|'):
        raise ValueError("Ajan adı boş olmamalı ve dosya adında kullanılabilmeli")
    if team not in ("Blue", "Red"):
        raise ValueError("Kayıt renkleri için team Blue veya Red olmalı")

    # Fizik modeli ve mevcut uçuş/füze kontrolcü ayarlarını kullanıyoruz.
    # Bu ayarlar taktik karar veya otomatik ateşleme içermiyor.
    aircraft_config = copy_config(f16_config)
    missile_config = copy_config(AAM_config)
    for config in (aircraft_config, missile_config):
        config.data_output_xml = None
        config.fg_sleep_time = None
    aircraft_config.aircraft_simulation.Sim_time_step = 1
    missile_config.missile_simulation.Sim_time_step = 1

    config = SimpleNamespace(
        agent_name=name,
        aircraft_name="F-16",  # Kayıt etiketi; model f16_config.fdm_xml ile seçilir.
        team=team,
        agent_parameters=Agent_parameters(ammo=missile_count, **spawn),
        aircraft_simObj_conf=aircraft_config,
        missile_simObj_conf=missile_config,
    )
    # BVRGym mevcut model dosyalarını göreli yollardan yükler.
    previous_cwd = Path.cwd()
    try:
        os.chdir(bvrgym)
        return BaseBVRAgent(config, None)
    finally:
        os.chdir(previous_cwd)


def create_agents(configs):
    """Ajanlar ve son kullanıcı komutları; otomatik hedef bağlantısı kurulmaz."""
    agents, commands = {}, {}
    for spec in configs:
        name = spec["name"]
        if name in agents:
            raise ValueError(f"Ajan adı benzersiz olmalı: {name}")
        agent = create_agent(name=name, team=spec["team"],
                             missile_count=spec["missile_count"], spawn=spec["spawn"])
        agents[name] = agent
        set_flight_command(commands, name, *spec["initial_command"])
    return agents, commands


def set_flight_command(commands, name, heading, altitude, throttle):
    """Verilen hedefleri sakla; manevra veya hedef kararı hesaplama."""
    commands[name] = [heading, altitude, throttle]


def fire_missile(agents, shooter_name, target_name):
    """Yalnızca açık atış isteğiyle hedefi bağla ve ateşlemeyi dene."""
    shooter, target = agents[shooter_name], agents[target_name]
    if shooter is target:
        raise ValueError("Ajan kendisine füze ateşleyemez")
    if shooter.healthPoints <= 0:
        return False
    before = sum(missile.is_active() for missile in shooter.ammo.values())
    shooter.set_target(target)
    shooter.launch_missile()
    after = sum(missile.is_active() for missile in shooter.ammo.values())
    return after > before


def step_agents(agents, commands):
    """Her ajanı yalnızca saklanan kullanıcı komutuyla bir adım ilerlet."""
    for name, agent in agents.items():
        agent.apply_action(commands[name])


def main():
    agents, commands = create_agents(AGENT_CONFIGS)
    scenario = SimpleNamespace(
        conf=SimpleNamespace(tacview_output_dir=str(RECORDING_DIR)),
        all_agents=list(agents.values()),
    )
    logger = TacviewLogger(scenario)
    logger.log_flight_data()
    clock = next(iter(agents.values())).simObj
    sim_start = clock.get_sim_time_sec()
    wall_start = time.monotonic()

    print("Ajanlar:", ", ".join(agents))
    print("Başlangıç komutları:", commands)
    print("Otomatik atış yok. Kayıt klasörü:", RECORDING_DIR)

    # Örnek açık komutlar (gerekirse senaryo kodunda kullan):
    # set_flight_command(commands, "Kartal-1", 90, 8000, 0.55)
    # fire_missile(agents, "Kartal-1", "Bogey-1")
    # Dış komut bağlantısı bu sürümde henüz yok.
    try:
        while clock.get_sim_time_sec() - sim_start < SIM_DURATION:
            step_agents(agents, commands)
            logger.log_flight_data()
            elapsed_sim = clock.get_sim_time_sec() - sim_start
            remaining = wall_start + elapsed_sim - time.monotonic()
            if remaining > 0:
                time.sleep(remaining)
    except KeyboardInterrupt:
        print("\nUçuş durduruldu.")
    finally:
        logger.save_logs()
        print("Tacview CSV kayıtları kaydedildi:", RECORDING_DIR)


if __name__ == "__main__":
    main()
